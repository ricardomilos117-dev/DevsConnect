# Configurações do Servidor
PORT=12000
NODE_ENV=development

# Banco de Dados MongoDB
# Para desenvolvimento local:
MONGODB_URI=mongodb://localhost:27017/devsconnect

# Para MongoDB Atlas (recomendado para produção):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/devsconnect

# JWT Secret (use uma string aleatória e segura)
JWT_SECRET=seu_jwt_secret_muito_seguro_aqui_mude_para_producao

# CORS Origins (para produção, especifique os domínios permitidos)
CORS_ORIGIN=http://localhost:3000

# Upload de arquivos
MAX_FILE_SIZE=5242880
UPLOAD_PATH=uploads/

# Email (opcional - para funcionalidades futuras)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=seu_email@gmail.com
# EMAIL_PASS=sua_senha_de_app